"""Negative control: copy of the collected data with every ledger_hash's last hex digit changed."""
import csv
import sys
src, dst = sys.argv[1], sys.argv[2]
with open(f"{src}/ledgers.csv", newline="") as f:
    rows = list(csv.DictReader(f))
for r in rows:
    h = r["ledger_hash"]
    r["ledger_hash"] = h[:-1] + ("0" if h[-1] != "0" else "1")
with open(f"{dst}/ledgers.csv", "w", newline="") as f:
    w = csv.DictWriter(f, rows[0].keys())
    w.writeheader()
    w.writerows(rows)
print(f"tampered {len(rows)} ledger hashes")
